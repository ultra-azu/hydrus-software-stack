<sdf version="1.6">
  <model name="submarine">
    <!-- Define the submarine's main link -->
    <link name="body">
      <!-- Collision properties -->
      <collision name="collision">
      	<pose>0 0 -10 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.5</radius>
            <length>4.0</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Visual properties -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.5</radius>
            <length>4.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.5 1</ambient> <!-- Dark blue color -->
          <diffuse>0.1 0.1 0.5 1</diffuse>
          <specular>0.1 0.1 0.5 1</specular>
        </material>
      </visual>

      <!-- Inertial properties -->
      <inertial>
        <mass>20</mass> <!-- Mass in kilograms -->
        <inertia>
          <ixx>208.33</ixx>
          <iyy>208.33</iyy>
          <izz>41.67</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Add a rudder for control -->
    <link name="rudder">
      <pose>0 -1.0 0 0 0 0</pose> <!-- Position relative to the body -->
      <collision name="rudder_collision">
        <geometry>
          <box>
            <size>0.1 0.5 1.0</size>
          </box>
        </geometry>
      </collision>
      <visual name="rudder_visual">
        <geometry>
          <box>
            <size>0.1 0.5 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient> <!-- Gray color -->
        </material>
      </visual>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Joint to connect the rudder to the body -->
    <joint name="rudder_joint" type="revolute">
      <parent>body</parent>
      <child>rudder</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
        </limit>
      </axis>
    </joint>
  </model>
</sdf>
